<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: recordings, transcripts and calendar titles stay on this phone -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
