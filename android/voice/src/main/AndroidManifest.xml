<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Find the event that's running and write the note into it (or add an event).
         No INTERNET: speech is recognised on the phone, the calendar's own app syncs. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- The Gadgetbridge builds that may send voice (shown as installed or not in the app) -->
    <queries>
        <package android:name="nodomain.freeyourgadget.gadgetbridge" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge.nightly" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge.nightly_nopebble" />
        <package android:name="com.espruino.gadgetbridge.banglejs" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Voice">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gadgetbridge binds to this with its VOICE_COMMAND action. Exported without a permission
             because Gadgetbridge declares none to hold; VoiceService only accepts messages whose
             sender uid belongs to a Gadgetbridge package. -->
        <service
            android:name=".gadgetbridge.VoiceService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="nodomain.freeyourgadget.gadgetbridge.VOICE_COMMAND" />
            </intent-filter>
        </service>

        <service
            android:name=".pipeline.TranscribeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
