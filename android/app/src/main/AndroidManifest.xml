<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read the phone's calendars (Google Calendar syncs into the calendar provider) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Only for the weather forecast (Open-Meteo). Turn the weather off in the app, or revoke
         "Network" on GrapheneOS: the agenda is then sent without weather. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the hourly update scheduled after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The Gadgetbridge builds it can send to -->
    <queries>
        <package android:name="nodomain.freeyourgadget.gadgetbridge" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge.nightly" />
        <package android:name="nodomain.freeyourgadget.gadgetbridge.nightly_nopebble" />
        <package android:name="com.espruino.gadgetbridge.banglejs" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TodayOnRails">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sync.SyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".sync.ClockChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
