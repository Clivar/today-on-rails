    <string name="face_today_card_when_during">During events</string>
    <string name="face_today_card_when_before">%1$s before</string>
    <string name="face_today_card_when_both">During events and %1$s before</string>
    <string name="today_card_note">The Today card shows one event large, with what comes after it. It helps to stay on track, during an event or just before one. The rest of the time the watch shows a big clock.</string>
    <string name="rail_label">Green rail</string>
    <string name="rail_note">The green rail runs along the edge of the watch from now to your next event, so you see how far away it is without reading a time. A long rail is hard to miss: an event that\'s still hours away stays in the back of your mind. During an event the rail runs to its end and shows the time that\'s left. A longer reach is the better reminder; a shorter one saves battery.</string>
    <string name="choice_default">%1$s (default)</string>

    <string name="nudges">Nudges</string>
    <string name="nudges_note">The watch buzzes by itself at these moments, while its screen is on or dimmed (always-on). With the screen fully off it can\'t, so a buzz can be missed then. No notifications involved.</string>
    <string name="buzz_at_start">Buzz when an event starts</string>
    <string name="buzz_before_end">Buzz 5 minutes before an event ends</string>
    <string name="get_ready">Get ready for events with a place</string>
    <string name="get_ready_note">When an event has a location, the Today card shows "Get ready" earlier, so there\'s time to get going.</string>
    <string name="buzz_get_ready">Buzz when it\'s time to get ready</string>
    <string name="face_today_card_when_place">%1$s · at a place: %2$s before</string>

    <string name="calendars">Calendars</string>
    <string name="calendars_none">No calendars found. Add a Google account to the phone, or allow calendar access.</string>

    <string name="weather">Weather</string>
    <string name="weather_switch">Show the weather (uses the internet)</string>
    <string name="weather_note">The forecast comes from Open-Meteo: only the coordinates below are sent, no account needed. Without it the watchface hides the temperature. Turn off Breezy Weather\'s Gadgetbridge option: only one app can send weather.</string>
    <string name="city">City shown in the watch\'s weather app</string>
    <string name="latitude">Latitude</string>
    <string name="longitude">Longitude</string>

    <string name="sent">Sent to the watch</string>
    <string name="sent_note">The watch picks up new data on its own weather update, usually within 30 minutes.</string>

