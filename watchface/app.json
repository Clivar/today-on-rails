{
  "configVersion": "v3",
  "app": {
    "appId": 1076410,
    "appName": "Today On Rails",
    "appType": "watchface",
    "version": {
      "code": 100,
      "name": "1.0.0"
    },
    "icon": "images/preview.png",
    "vender": "Today On Rails",
    "description": "Big clock and today's agenda on a rail around the edge; the Today card keeps you on track during events. Calendar from the Today On Rails phone app via Gadgetbridge."
  },
  "permissions": [
    "data:user.hd.heart_rate",
    "data:user.hd.step"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "4.2",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "bip6": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1
        }
      },
      "platforms": [
        {
          "name": "bip6",
          "deviceSource": 9765120
        },
        {
          "name": "bip6",
          "deviceSource": 9765121
        },
        {
          "name": "bip6",
          "deviceSource": 10158337
        }
      ],
      "designWidth": 390
    }
  },
  "i18n": {
    "en-US": {
      "name": "Today On Rails"
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
